<?xml version="1.0" encoding="utf-8"?>
<!--
  Fondo del icono adaptativo: azul corporativo con un resplandor naranja detrás
  del balón, para alinear el icono de la app con el que ya está en la ficha de
  Play Store. Sustituye al color plano @color/ic_launcher_background.

  El lienzo es de 108dp, el estándar del icono adaptativo. Las coordenadas de
  los centros y los radios salen de los degradados radiales del diseño.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Base azul: claro arriba a la izquierda, casi negro en las esquinas. -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="38.88"
                android:centerY="32.4"
                android:gradientRadius="102.4">
                <item android:offset="0" android:color="#FF17508F" />
                <item android:offset="0.48" android:color="#FF052E5C" />
                <item android:offset="1" android:color="#FF001428" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Resplandor naranja detrás del balón. Se apaga antes del borde para que
         no compita con el azul ni se recorte raro al aplicar la máscara. -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54"
                android:centerY="66.96"
                android:gradientRadius="86">
                <item android:offset="0" android:color="#8CFF6B35" />
                <item android:offset="0.34" android:color="#47DD4E3E" />
                <item android:offset="0.62" android:color="#00DD4E3E" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
